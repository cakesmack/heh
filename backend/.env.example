# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/highland_events
DATABASE_URL_POOLER=

# Security
SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Application
DEBUG=True
APP_NAME=Highland Events API
APP_VERSION=1.0.0

# CORS Origins (comma-separated) — must match config.py field name
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# External Services
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODE_API_KEY=
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_webhook_secret
RESEND_API_KEY=

# Cloudinary (optional — falls back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare Images (optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_HASH=

# Ordnance Survey (optional)
OS_PLACES_API_KEY=
OS_API_KEY=

# Transactional Email / Hostinger SMTP (optional)
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=
HOSTINGER_SMTP_PASS=
EMAIL_FROM_ADDRESS="Highland Events Hub <noreply@highlandeventshub.co.uk>"

# Password Reset / Gmail SMTP (optional)
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=60
ADMIN_EMAIL=

# Campaign Email / Amazon SES SMTP (optional)
CAMPAIGN_SMTP_HOST=email-smtp.eu-west-2.amazonaws.com
CAMPAIGN_SMTP_PORT=587
CAMPAIGN_SMTP_USER=
CAMPAIGN_SMTP_PASS=
CAMPAIGN_FROM_ADDRESS="Highland Events Hub <contact@highlandeventshub.co.uk>"

# Media Upload
UPLOAD_DIR=static/uploads

# Check-in Settings
CHECKIN_MAX_DISTANCE_METERS=100
CHECKIN_TIME_BUFFER_MINUTES=15

# Highlands Geographic Boundaries
HIGHLANDS_LAT_MIN=56.0
HIGHLANDS_LAT_MAX=59.0
HIGHLANDS_LON_MIN=-7.0
HIGHLANDS_LON_MAX=-3.0

# Feature Flags
TICKETING_PUBLIC_ENABLED=True
